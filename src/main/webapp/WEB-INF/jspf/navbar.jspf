<%@ page import="java.util.Locale" %>
<%
    String navUser = (String) session.getAttribute("username");
    String navRole = (String) session.getAttribute("userRole");
    if (navRole == null) navRole = "public";
    navRole = navRole.toLowerCase(Locale.ROOT);
    String navHome = "public".equals(navRole) ? "UserHome.jsp" : ("police".equals(navRole) ? "PoliceHome.jsp" : "AdminsHome.jsp");
%>
<header class="appbar">
    <div class="appbar-inner">
        <a class="brand" href="<%= navHome %>" aria-label="Crime Report System home">
            <img class="brand-mark" src="images/crslogo.png" alt="">
            <span>Crime Report</span>
        </a>
        <nav class="appbar-links" aria-label="Primary navigation">
            <a href="<%= navHome %>">Dashboard</a>
            <% if ("public".equals(navRole)) { %>
                <a href="ReportSub.jsp">Submit report</a>
                <a href="MyReports.jsp">My reports</a>
            <% } else if ("police".equals(navRole)) { %>
                <a href="UpdateCrime.jsp">Crime reports</a>
                <a href="StateUpgrade.jsp">Status updates</a>
                <a href="PoliceInfo.jsp">Police directory</a>
            <% } else if ("admin".equals(navRole)) { %>
                <a href="ReportMan.jsp">Reports</a>
                <a href="UserManage.jsp">Users</a>
                <a href="PoliceInfo.jsp">Police</a>
                <a href="AdminInfo.jsp">Admins</a>
            <% } %>
        </nav>
        <div class="appbar-actions">
            
            <div class="account">
                <button class="account-trigger" type="button" aria-expanded="false" aria-controls="crsAccountMenu">
                    <img class="account-photo" src="<%= request.getContextPath() %>/ProfileImage.jsp" alt="Your profile">
                    <span class="account-name"><%= navUser == null ? "Guest" : navUser %></span>
                    <span class="account-chevron" aria-hidden="true"></span>
                </button>
                <div class="account-menu" id="crsAccountMenu">
                    <% if (navUser != null) { %>
                        <a href="Settings.jsp">Settings</a>
                        <a href="Notification.jsp">Notifications</a>
                        <a href="Logout.jsp">Sign out</a>
                    <% } else { %>
                        <a href="Login.jsp">Sign in</a>
                        <a href="Registration.jsp">Create account</a>
                    <% } %>
                </div>
            </div>
            <button class="mobile-menu" type="button" aria-label="Open navigation" aria-expanded="false">☰</button>
        </div>
    </div>
    <div class="mobile-nav" id="crsMobileNav">
        <a href="<%= navHome %>">Dashboard</a>
        <% if ("public".equals(navRole)) { %>
            <a href="ReportSub.jsp">Submit report</a><a href="MyReports.jsp">My reports</a>
        <% } else if ("police".equals(navRole)) { %>
            <a href="UpdateCrime.jsp">Crime reports</a><a href="StateUpgrade.jsp">Status updates</a><a href="PoliceInfo.jsp">Police directory</a>
        <% } else if ("admin".equals(navRole)) { %>
            <a href="ReportMan.jsp">Reports</a><a href="UserManage.jsp">Users</a><a href="PoliceInfo.jsp">Police</a><a href="AdminInfo.jsp">Admins</a>
        <% } %>
    </div>
</header>
